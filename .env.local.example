# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud Vision (server-side face detection)
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_CLIENT_EMAIL=your_service_account@your_gcp_project.iam.gserviceaccount.com
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Formspree (server-side contact-form email notifications)
FORMSPREE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# Stripe (listing publishing fee; hosted Checkout redirect)
# Prefer a restricted key (rk_...) with Checkout Sessions read+write.
STRIPE_SECRET_KEY=rk_test_placeholder
# From `stripe listen` locally; from the webhook endpoint config in prod.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Listing fee in cents (500 = $5.00). Unset or 0 disables payments entirely.
LISTING_FEE_CENTS=500
# Temporarily suspend payments without changing the fee: true = skip Stripe,
# post listings active immediately (like free mode), amount preserved.
PAYMENTS_SUSPENDED=false

# Supabase service-role secret (webhook/cleanup writes only; server-only)
SUPABASE_SECRET_KEY=sb_secret_placeholder

# Cleanup sweep (stale pending listings)
CLEANUP_SECRET=long_random_string
